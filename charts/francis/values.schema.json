{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Francis runtime Helm chart values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "description": "Number of runtime replicas. Only 1 replica is allowed when database.type is \"sqlite\".",
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "type": "object" },
    "commonAnnotations": { "type": "object" },
    "database": {
      "type": "object",
      "properties": {
        "type": {
          "description": "Database backend. \"sqlite\" works only with replicaCount 1.",
          "type": "string",
          "enum": ["postgres", "sqlite"]
        },
        "sqlite": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "existingClaim": { "type": "string" },
                "mountPath": { "type": "string", "minLength": 1 },
                "storageClass": { "type": "string" },
                "accessModes": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "size": { "type": "string", "minLength": 1 },
                "annotations": { "type": "object" }
              }
            }
          }
        },
        "postgres": {
          "type": "object",
          "properties": {
            "connectionString": { "type": "string" }
          }
        },
        "queryLog": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "includeParameters": { "type": "boolean" },
            "slowThreshold": { "type": "string" }
          }
        },
        "operationLog": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "slowThreshold": { "type": "string" }
          }
        }
      }
    },
    "runtimePSKs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "runtimeId": { "type": "string" },
    "bootstrap": {
      "type": "object",
      "properties": {
        "method": { "type": "string", "enum": ["psk", "jwt"] },
        "hostPSK": { "type": "string" },
        "jwt": {
          "type": "object",
          "properties": {
            "issuer": { "type": "string" },
            "audience": { "type": "string" },
            "jwksURL": { "type": "string" },
            "staticJWKS": { "type": "string" }
          }
        }
      }
    },
    "tuning": {
      "type": "object",
      "properties": {
        "workloadCertTTL": { "type": "string" },
        "healthCheckDeadline": { "type": "string" },
        "alarmsPollInterval": { "type": "string" },
        "alarmsLeaseDuration": { "type": "string" },
        "shutdownGracePeriod": { "type": "string" },
        "maxHosts": { "type": "integer", "minimum": 0 }
      }
    },
    "log": {
      "type": "object",
      "properties": {
        "level": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "json": { "type": "boolean" }
      }
    },
    "openTelemetry": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string" },
        "protocol": { "type": "string", "enum": ["http/protobuf", "grpc"] },
        "traces": { "type": "string", "enum": ["otlp", "console", "none"] },
        "metrics": { "type": "string", "enum": ["otlp", "console", "none"] },
        "logs": { "type": "string", "enum": ["otlp", "console", "none"] },
        "sampler": { "type": "string" },
        "samplerArg": { "type": "string" }
      }
    },
    "existingConfigSecret": { "type": "string" },
    "existingConfigSecretKey": { "type": "string" },
    "service": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "headless": {
          "type": "object",
          "properties": {
            "annotations": { "type": "object" }
          }
        },
        "enabled": { "type": "boolean" },
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "nodePort": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
        "loadBalancerIP": { "type": "string" },
        "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } },
        "externalTrafficPolicy": { "type": "string", "enum": ["", "Cluster", "Local"] },
        "annotations": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "podAntiAffinity": { "type": "string", "enum": ["", "soft", "hard"] },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "startupProbe": { "$ref": "#/definitions/probe" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "updateStrategy": { "type": "object" },
    "podManagementPolicy": { "type": "string", "enum": ["OrderedReady", "Parallel"] },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "extraArgs": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
