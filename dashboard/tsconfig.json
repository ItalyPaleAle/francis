{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["svelte", "vite/client", "node"],
    /* Path aliases */
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "$components/*": ["./src/components/*"],
      "$pages/*": ["./src/pages/*"]
    }
  },
  "include": ["src/**/*", "e2e/**/*.ts", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules/*", "dist/*"]
}
